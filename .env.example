# Copiá este archivo como .env.local y completá los valores.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).

# Supabase → Project Settings → API
SUPABASE_URL=
# Supabase → Project Settings → API Keys → service_role / secret key.
# Es SECRETA: solo la usa el servidor. No le pongas NEXT_PUBLIC_ adelante.
SUPABASE_SERVICE_ROLE_KEY=

# Texto largo al azar para "salar" el hash de las IPs.
# Generalo con: openssl rand -hex 32
IP_HASH_SALT=
